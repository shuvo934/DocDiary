<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_prescription_rx"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".dynamic_prescription.fragments.PrescriptionRxFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/_4sdp"
        android:paddingTop="@dimen/_4sdp"
        android:paddingEnd="@dimen/_4sdp"
        android:paddingBottom="@dimen/_10sdp">

        <!-- Medicine / Therapy selector -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_rx_type_selector"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="@dimen/_4sdp"
            app:cardCornerRadius="@dimen/_23sdp"
            app:cardElevation="0dp"
            app:strokeColor="#27AEB8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- Medicine segment -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_rx_medicine_segment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#27AEB8"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_8sdp"
                        android:paddingEnd="@dimen/_8sdp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_rx_medicine_segment"
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:contentDescription="Medicine"
                            android:src="@drawable/pill"
                            app:tint="@android:color/white" />

                        <TextView
                            android:id="@+id/tv_rx_medicine_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="MEDICINE"
                            android:paddingTop="@dimen/_2sdp"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_9sdp" />

                        <!-- Medicine count badge -->

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_rx_medicine_count"
                            android:layout_width="@dimen/_23sdp"
                            android:layout_height="@dimen/_23sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            app:cardBackgroundColor="@color/prescription_primary_light"
                            app:cardCornerRadius="@dimen/_50sdp"
                            app:cardElevation="0dp">

                            <TextView
                                android:id="@+id/tv_rx_medicine_count"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:minWidth="@dimen/_23sdp"
                                android:paddingStart="@dimen/_6sdp"
                                android:paddingEnd="@dimen/_6sdp"
                                android:paddingTop="@dimen/_2sdp"
                                android:text="0"
                                android:textColor="@color/prescription_primary"
                                android:textSize="@dimen/_8sdp" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Visible only when medicine access is denied -->

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_rx_medicine_locked"
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:contentDescription="Medicine access locked"
                            android:src="@drawable/ic_medicine_locked_24"
                            android:visibility="gone"
                            app:tint="#98A2B3" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Therapy segment -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_rx_therapy_segment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_8sdp"
                        android:paddingEnd="@dimen/_8sdp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_rx_therapy_segment"
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:contentDescription="Therapy"
                            android:src="@drawable/ic_therapy_24"
                            app:tint="#667085" />

                        <TextView
                            android:id="@+id/tv_rx_therapy_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="THERAPY"
                            android:paddingTop="@dimen/_2sdp"
                            android:textColor="#4B5563"
                            android:textSize="@dimen/_9sdp" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_rx_therapy_count"
                            android:layout_width="@dimen/_23sdp"
                            android:layout_height="@dimen/_23sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            app:cardBackgroundColor="#F2F4F7"
                            app:cardCornerRadius="@dimen/_50sdp"
                            app:cardElevation="0dp">

                            <TextView
                                android:id="@+id/tv_rx_therapy_count"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="center"
                                android:minWidth="@dimen/_23sdp"
                                android:paddingStart="@dimen/_6sdp"
                                android:paddingEnd="@dimen/_6sdp"
                                android:paddingTop="@dimen/_2sdp"
                                android:text="0"
                                android:textColor="#667085"
                                android:textSize="@dimen/_8sdp" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Medicine section -->

        <include
            android:id="@+id/section_rx_medicine"
            layout="@layout/view_prescription_expandable_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"/>

        <!-- Therapy section -->

        <include
            android:id="@+id/section_rx_therapy"
            layout="@layout/view_prescription_expandable_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="@dimen/_5sdp" />

        <!-- Treatment plan heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:fontFamily="@font/poppins"
            android:text="TREATMENT PLAN"
            android:textColor="#667085"
            android:textSize="@dimen/_8sdp"
            android:textStyle="bold" />

        <!-- Treatment plan section -->

        <include
            android:id="@+id/section_rx_treatment_plan"
            layout="@layout/view_prescription_expandable_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>