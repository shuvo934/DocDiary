<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_prescription_review"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".dynamic_prescription.fragments.PrescriptionReviewFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/_4sdp"
        android:paddingTop="@dimen/_4sdp"
        android:paddingEnd="@dimen/_4sdp"
        android:paddingBottom="@dimen/_10sdp">

        <!-- Review status -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_review_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFAEB"
            app:cardCornerRadius="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_4sdp"
            app:cardElevation="0dp"
            app:strokeColor="#FEDF89"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_8sdp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_review_status_icon"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    app:cardBackgroundColor="#F79009"
                    app:cardCornerRadius="@dimen/_50sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_review_status_icon"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_gravity="center"
                        android:contentDescription="Prescription review status"
                        android:src="@drawable/ic_review_attention_24" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_review_status_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:text="Rx information required"
                    android:textColor="#B54708"
                    android:textSize="@dimen/_9sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/card_review_status_icon"
                    app:layout_constraintTop_toTopOf="@id/card_review_status_icon" />

                <TextView
                    android:id="@+id/tv_review_status_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Add at least one Rx item before generating."
                    android:textColor="#667085"
                    android:textSize="@dimen/_7sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_review_status_value"
                    app:layout_constraintTop_toBottomOf="@id/tv_review_status_value" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Clinical summary -->

        <include
            android:id="@+id/review_section_clinical"
            layout="@layout/view_prescription_review_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"/>

        <!-- RX summary -->

        <include
            android:id="@+id/review_section_rx"
            layout="@layout/view_prescription_review_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"/>

        <!-- Advice summary -->

        <include
            android:id="@+id/review_section_advice"
            layout="@layout/view_prescription_review_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>