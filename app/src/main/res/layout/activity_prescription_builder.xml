<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/presc_builder_root"
    android:background="@drawable/green_gray_background"
    tools:context=".dynamic_prescription.PrescriptionBuilder">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:background="@color/white">

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/prescription_builder_full_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:background="@color/light_green">

        <!-- Top toolbar -->
        <RelativeLayout
            android:id="@+id/app_bar_prescription_builder"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/light_green"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="@dimen/_19sdp"
                android:layout_height="@dimen/_19sdp"
                android:id="@+id/back_logo_of_prescription_builder"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_12sdp"
                android:src="@drawable/arrow_back"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="5dp"
                android:layout_toEndOf="@+id/back_logo_of_prescription_builder"
                android:layout_toStartOf="@+id/prescription_hist_btn"
                android:fontFamily="@font/poppins_bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/pat_prescription"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sdp" />

            <ImageView
                android:id="@+id/prescription_hist_btn"
                android:layout_width="@dimen/_19sdp"
                android:layout_height="@dimen/_19sdp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/prescription_prv_btn"
                android:layout_marginEnd="@dimen/_12sdp"
                android:visibility="gone"
                android:layout_alignWithParentIfMissing="true"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/medical_record"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/prescription_prv_btn"
                android:layout_width="@dimen/_19sdp"
                android:layout_height="@dimen/_19sdp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="@dimen/_14sdp"
                android:src="@drawable/prescription_prv"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

        </RelativeLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/app_bar_prescription_builder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MaterialCardView.Cut">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Patient summary -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_patient_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    app:cardBackgroundColor="@color/prescription_surface"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:strokeColor="@color/prescription_outline"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_10sdp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_patient_avatar"
                            android:layout_width="@dimen/_40sdp"
                            android:layout_height="@dimen/_40sdp"
                            app:cardBackgroundColor="@color/prescription_primary_light"
                            app:cardCornerRadius="@dimen/_50sdp"
                            app:cardElevation="0dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:id="@+id/patient_avatar_pic"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/person_24"
                                android:padding="@dimen/_6sdp"
                                app:tint="@color/prescription_primary"
                                tools:ignore="ContentDescription" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:orientation="vertical"
                            android:layout_toStartOf="@+id/rx_visit_details"
                            android:layout_toEndOf="@+id/card_patient_avatar">

                            <TextView
                                android:id="@+id/patient_name_in_presc_buider"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:layout_marginEnd="@dimen/_8sdp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:fontFamily="@font/poppins_bold"
                                tools:text="Halima Khatun"
                                android:textColor="@color/prescription_text_primary"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/patient_code_in_presc_builder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:layout_marginEnd="@dimen/_8sdp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:fontFamily="@font/poppins"
                                tools:text="202222222"
                                android:textColor="@color/prescription_text_secondary"
                                android:textSize="@dimen/_8sdp" />

                            <TextView
                                android:id="@+id/patient_details_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:layout_marginEnd="@dimen/_8sdp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:fontFamily="@font/poppins"
                                tools:text="Female • 1Y 1M"
                                android:textColor="@color/prescription_text_secondary"
                                android:textSize="@dimen/_8sdp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rx_visit_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/patient_visit_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:padding="@dimen/_3sdp"
                                tools:text="Visit: 00002"
                                android:fontFamily="@font/patua_one"
                                android:background="@color/prescription_primary_light"
                                android:textColor="@color/prescription_primary"
                                android:textSize="@dimen/_9sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/patient_visit_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:padding="@dimen/_3sdp"
                                tools:text="Date: 22/08/2026"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:fontFamily="@font/patua_one"
                                android:background="@color/prescription_primary_light"
                                android:textColor="@color/prescription_primary"
                                android:textSize="@dimen/_9sdp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </RelativeLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Disease + Treatment templates -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_templates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/prescription_surface"
                    app:cardCornerRadius="@dimen/_8sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:strokeColor="@color/prescription_outline"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@id/card_patient_summary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/_48sdp"
                        android:padding="@dimen/_10sdp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_template_icon"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            app:cardBackgroundColor="@color/prescription_primary_light"
                            app:cardCornerRadius="@dimen/_8sdp"
                            app:cardElevation="0dp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/template"
                                app:tint="@color/prescription_primary"
                                android:padding="@dimen/_6sdp"
                                tools:ignore="ContentDescription" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@+id/card_template_icon"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/iv_template_status">

                            <TextView
                                android:id="@+id/tv_templates_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:layout_marginEnd="@dimen/_8sdp"
                                android:text="Prescription Templates"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="@color/prescription_text_primary"
                                android:textSize="@dimen/_11sdp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:id="@+id/tv_templates_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:text="No template loaded"
                                android:textColor="@color/prescription_text_secondary"
                                android:textSize="@dimen/_8sdp"
                                android:fontFamily="@font/poppins"
                                tools:ignore="HardcodedText" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_template_status"
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:src="@drawable/outline_check_circle_24"
                            android:padding="@dimen/_5sdp"
                            app:tint="@color/prescription_primary"
                            android:layout_toStartOf="@+id/tv_template_chevron"
                            android:layout_centerVertical="true"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/tv_template_chevron"
                            android:layout_width="@dimen/_26sdp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="›"
                            android:textColor="@color/prescription_text_secondary"
                            android:fontFamily="@font/archivo_bold"
                            android:textSize="@dimen/_24sdp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"
                            tools:ignore="HardcodedText" />

                    </RelativeLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Main prescription tabs -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_prescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/green_sea"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="@dimen/_2sdp"
                    app:tabBackground="@drawable/prescription_tab_color_selector"
                    app:tabIndicator="@color/green_sea"
                    app:tabMode="fixed"
                    app:tabRippleColor="@color/prescription_primary_light"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextAppearance="@style/PrescriptionTabTextAppearance"
                    app:layout_constraintTop_toBottomOf="@id/card_templates"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clinical" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rx" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Advice" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Review" />

                </com.google.android.material.tabs.TabLayout>

                <!-- Clinical/Rx/Advice/Review fragments will load here -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/prescription_view_pager"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:background="@color/white"
                    app:layout_constraintTop_toBottomOf="@id/tab_prescription"
                    app:layout_constraintBottom_toTopOf="@id/card_bottom_actions"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Fixed bottom actions -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_bottom_actions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_8sdp"
                        android:paddingTop="@dimen/_6sdp"
                        android:paddingEnd="@dimen/_8sdp"
                        android:paddingBottom="@dimen/_4sdp">

                        <!-- Final confirmation -->
                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/checkbox_review_confirmation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/green_sea"
                            android:fontFamily="@font/poppins"
                            android:visibility="gone"
                            android:enabled="false"
                            android:alpha="0.45"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/_10sdp"
                            android:paddingEnd="@dimen/_10sdp"
                            android:paddingTop="@dimen/_1sdp"
                            android:text="I have reviewed the prescription details"
                            android:textColor="#344054"
                            android:textSize="@dimen/_8sdp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_gravity="center">

<!--                            <com.google.android.material.button.MaterialButton-->
<!--                                android:id="@+id/btn_save_draft"-->
<!--                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"-->
<!--                                android:layout_width="0dp"-->
<!--                                android:layout_height="@dimen/_40sdp"-->
<!--                                android:layout_weight="1"-->
<!--                                android:fontFamily="@font/poppins_bold"-->
<!--                                android:text="SAVE DRAFT"-->
<!--                                android:backgroundTint="@color/white"-->
<!--                                android:paddingBottom="@dimen/_2sdp"-->
<!--                                android:textColor="@color/prescription_primary"-->
<!--                                android:textStyle="bold"-->
<!--                                android:textSize="@dimen/_9sdp"-->
<!--                                app:cornerRadius="@dimen/_8sdp"-->
<!--                                app:strokeColor="@color/green_sea"-->
<!--                                app:strokeWidth="1dp" />-->

<!--                            <Space-->
<!--                                android:layout_width="@dimen/_10sdp"-->
<!--                                android:layout_height="1dp" />-->

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_next"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/_40sdp"
                                android:layout_weight="1"
                                android:text="NEXT: RX"
                                android:fontFamily="@font/poppins_bold"
                                android:textSize="@dimen/_9sdp"
                                android:paddingBottom="@dimen/_2sdp"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                app:backgroundTint="@color/green_sea"
                                app:cornerRadius="@dimen/_8sdp" />

                        </LinearLayout>

                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_indicator_prescription_builder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:elevation="@dimen/_20sdp"
        android:visibility="gone"
        android:indeterminate="true"
        android:layout_gravity="center"/>

</RelativeLayout>
