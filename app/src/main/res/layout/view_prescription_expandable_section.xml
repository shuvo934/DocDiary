<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:focusable="false"
    app:cardBackgroundColor="@color/prescription_surface"
    app:cardCornerRadius="@dimen/_8sdp"
    app:cardElevation="@dimen/_1sdp"
    app:strokeColor="@color/prescription_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===================================================== -->
        <!-- Section header / collapsed appearance -->
        <!-- ===================================================== -->

        <RelativeLayout
            android:id="@+id/layout_section_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_5sdp">

            <!-- Actual section icon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_section_icon"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_section_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_6sdp"
                    android:contentDescription="Section icon"
                    app:srcCompat="@drawable/ic_objective_info_24"
                    app:tint="@color/prescription_primary" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Expand/collapse icon -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_section_expand"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Expand section"
                android:padding="@dimen/_7sdp"
                app:srcCompat="@drawable/ic_expand_more_24"
                app:tint="@color/prescription_text_secondary" />

            <!-- Add item button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_section_add"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:layout_toStartOf="@id/iv_section_expand"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/prescription_surface"
                app:cardCornerRadius="@dimen/_50sdp"
                app:cardElevation="0dp"
                app:strokeColor="@color/prescription_primary"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/add_24"
                    app:tint="@color/green_sea"
                    android:padding="@dimen/_6sdp"
                    tools:ignore="ContentDescription" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Item count badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_section_count"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_25sdp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_3sdp"
                android:layout_toStartOf="@id/btn_section_add"
                app:cardBackgroundColor="@color/prescription_primary_light"
                app:cardCornerRadius="@dimen/_50sdp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tv_section_count"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:minWidth="@dimen/_25sdp"
                    android:paddingStart="@dimen/_6sdp"
                    android:paddingEnd="@dimen/_6sdp"
                    android:paddingTop="@dimen/_2sdp"
                    android:text="0"
                    android:textColor="@color/prescription_primary"
                    android:textSize="@dimen/_8sdp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Section title -->
            <TextView
                android:id="@+id/tv_section_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_toEndOf="@id/card_section_icon"
                android:layout_toStartOf="@id/card_section_count"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:text="Section"
                android:textColor="@color/prescription_text_primary"
                android:textSize="@dimen/_11sdp" />

        </RelativeLayout>

        <!-- ===================================================== -->
        <!-- Expanded content -->
        <!-- Runtime default: GONE -->
        <!-- Design preview: VISIBLE -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/layout_section_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/prescription_outline" />

            <!-- Displayed when the section has no item -->
            <TextView
                android:id="@+id/tv_section_empty"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:text="No information added"
                android:textColor="@color/prescription_text_secondary"
                android:textSize="@dimen/_9sdp" />

            <!-- Displayed when items are available -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_section_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/_5sdp"
                android:paddingTop="@dimen/_4sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:visibility="gone"
                tools:itemCount="2" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>