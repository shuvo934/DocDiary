<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_5sdp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="@dimen/_8sdp"
    app:cardElevation="0dp"
    app:strokeColor="#DDE5EA"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_44sdp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/et_prescription_item_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/_44sdp"
            android:background="@null"
            android:fontFamily="@font/poppins"
            android:gravity="center_vertical"
            android:hint="Write here"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingStart="@dimen/_12sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:textColor="#243238"
            android:textColorHint="#98A2B3"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_prescription_item"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_delete_prescription_item"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete item"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/cancel_24"
            app:tint="@color/red_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>