<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_design"
        android:padding="@dimen/_8sdp">

        <View
            android:id="@+id/drag_handler_clinical"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_7sdp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            android:background="#D0D5DD" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/drag_handler_clinical"
            android:layout_centerHorizontal="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_entry_header_icon"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="#EAF7F8"
                app:cardCornerRadius="@dimen/_9sdp"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_entry_header_icon"
                    android:layout_width="@dimen/_21sdp"
                    android:layout_height="@dimen/_21sdp"
                    android:layout_gravity="center"
                    android:contentDescription="Clinical entry"
                    android:src="@drawable/ic_complaint_24"
                    android:tint="@color/green_sea"
                    tools:ignore="HardcodedText,UseAppTint" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_toEndOf="@id/card_entry_header_icon"
                android:layout_toStartOf="@id/btn_close_entry_sheet"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_entry_sheet_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Add Complain"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11sdp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tv_entry_sheet_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Search or enter complain information"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_7sdp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_close_entry_sheet"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/close_24"
                android:tint="@color/white"
                tools:ignore="HardcodedText,UseAppTint" />

        </RelativeLayout>

    </RelativeLayout>

    <!-- Input content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingStart="@dimen/_12sdp"
        android:paddingTop="@dimen/_14sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_10sdp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_clinical_entry"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Complain"
            app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
            app:boxCornerRadiusBottomStart="@dimen/_8sdp"
            app:boxCornerRadiusTopEnd="@dimen/_8sdp"
            app:boxCornerRadiusTopStart="@dimen/_8sdp"
            app:endIconMode="dropdown_menu"
            tools:ignore="HardcodedText">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actv_clinical_entry"
                style="@style/Widget.MaterialComponents.AutoCompleteTextView.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine"
                android:maxLines="10"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_entry_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:fontFamily="@font/poppins"
            android:text="Select from the list or enter a custom complain"
            android:textColor="#667085"
            android:textSize="@dimen/_7sdp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_entry_notes"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:hint="Notes (Optional)"
            android:visibility="gone"
            app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
            app:boxCornerRadiusBottomStart="@dimen/_8sdp"
            app:boxCornerRadiusTopEnd="@dimen/_8sdp"
            app:boxCornerRadiusTopStart="@dimen/_8sdp"
            tools:visibility="visible"
            tools:ignore="HardcodedText">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_entry_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:gravity="start|top"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minLines="2"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Visible only in edit mode -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_clinical_entry"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_36sdp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="DELETE COMPLAIN"
            android:textColor="#D92D20"
            android:textSize="@dimen/_7sdp"
            android:visibility="gone"
            tools:ignore="HardcodedText"
            tools:visibility="visible" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAECF0" />

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="@dimen/_12sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_10sdp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_clinical_entry"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="CANCEL"
            android:textColor="@color/prescription_primary"
            android:textSize="@dimen/_9sdp"
            app:cornerRadius="@dimen/_8sdp"
            app:strokeColor="@color/green_sea"
            app:strokeWidth="1dp"
            tools:ignore="HardcodedText" />

        <Space
            android:layout_width="@dimen/_10sdp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_clinical_entry"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="ADD COMPLAIN"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_9sdp"
            app:backgroundTint="@color/green_sea"
            app:cornerRadius="@dimen/_8sdp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</LinearLayout>