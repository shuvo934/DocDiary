<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_design"
        android:padding="@dimen/_8sdp">

        <!-- Drag handle -->
        <View
            android:id="@+id/drag_handler_vital"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_7sdp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            android:background="#D0D5DD" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/drag_handler_vital"
            android:layout_centerHorizontal="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_vitals_header_icon"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                app:cardBackgroundColor="#EAF7F8"
                app:cardCornerRadius="@dimen/_9sdp"
                app:cardElevation="0dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_21sdp"
                    android:layout_height="@dimen/_21sdp"
                    android:layout_gravity="center"
                    android:contentDescription="Vitals"
                    android:tint="@color/green_sea"
                    android:src="@drawable/ic_vitals_24"
                    tools:ignore="HardcodedText" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_toEndOf="@+id/card_vitals_header_icon"
                android:layout_toStartOf="@+id/btn_close_vitals_sheet">

                <TextView
                    android:id="@+id/tv_vitals_sheet_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Add Vitals"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11sdp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Enter the patient’s current measurements"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_7sdp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_close_vitals_sheet"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="@dimen/_8sdp"
                android:tint="@color/white"
                android:src="@drawable/close_24"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                tools:ignore="HardcodedText" />

        </RelativeLayout>

    </RelativeLayout>

    <!-- Form -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/white"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_12sdp"
            android:paddingTop="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingBottom="@dimen/_6sdp">

            <!-- Blood pressure label -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_5sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="Blood Pressure"
                android:textColor="#344054"
                android:textSize="@dimen/_8sdp"
                tools:ignore="HardcodedText" />

            <!-- Systolic / Diastolic -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_vitals_systolic"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Systolic (mmHg)"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:suffixText="mmHg"
                    app:suffixTextAppearance="@style/PrescriptionVitalsSuffixText"
                    app:suffixTextColor="#667085"
                    tools:ignore="HardcodedText">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_vitals_systolic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:inputType="number"
                        android:maxLength="3"
                        android:imeOptions="actionDone"
                        android:selectAllOnFocus="true"
                        android:textColor="#101828"
                        android:textSize="@dimen/_10sdp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_vitals_diastolic"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Diastolic (mmHg)"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:suffixText="mmHg"
                    app:suffixTextAppearance="@style/PrescriptionVitalsSuffixText"
                    app:suffixTextColor="#667085"
                    tools:ignore="HardcodedText">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_vitals_diastolic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:inputType="number"
                        android:maxLength="3"
                        android:imeOptions="actionDone"
                        android:selectAllOnFocus="true"
                        android:textColor="#101828"
                        android:textSize="@dimen/_10sdp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Pulse / Temperature -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_vitals_pulse"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Pulse Rate (bpm)"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:suffixText="bpm"
                    app:suffixTextAppearance="@style/PrescriptionVitalsSuffixText"
                    app:suffixTextColor="#667085"
                    tools:ignore="HardcodedText">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_vitals_pulse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:inputType="number"
                        android:maxLength="3"
                        android:imeOptions="actionDone"
                        android:selectAllOnFocus="true"
                        android:textColor="#101828"
                        android:textSize="@dimen/_10sdp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_vitals_temperature"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Temperature (°F)"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:suffixText="°F"
                    app:suffixTextAppearance="@style/PrescriptionVitalsSuffixText"
                    app:suffixTextColor="#667085"
                    tools:ignore="HardcodedText">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_vitals_temperature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789."
                        android:fontFamily="@font/poppins_medium"
                        android:inputType="numberDecimal"
                        android:maxLength="5"
                        android:imeOptions="actionDone"
                        android:selectAllOnFocus="true"
                        android:textColor="#101828"
                        android:textSize="@dimen/_10sdp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- SpO2 / Respiratory rate -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_vitals_spo2"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="SpO₂ (%)"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:suffixText="%"
                    app:suffixTextAppearance="@style/PrescriptionVitalsSuffixText"
                    app:suffixTextColor="#667085"
                    tools:ignore="HardcodedText">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_vitals_spo2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:inputType="number"
                        android:maxLength="3"
                        android:imeOptions="actionDone"
                        android:selectAllOnFocus="true"
                        android:textColor="#101828"
                        android:textSize="@dimen/_10sdp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_vitals_respiratory_rate"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Respiratory Rate (/min)"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:suffixText="/min"
                    app:suffixTextAppearance="@style/PrescriptionVitalsSuffixText"
                    app:suffixTextColor="#667085"
                    tools:ignore="HardcodedText">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_vitals_respiratory_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:inputType="number"
                        android:maxLength="3"
                        android:imeOptions="actionDone"
                        android:selectAllOnFocus="true"
                        android:textColor="#101828"
                        android:textSize="@dimen/_10sdp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Height / Weight -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_vitals_height"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Height (cm)"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:suffixText="cm"
                    app:suffixTextAppearance="@style/PrescriptionVitalsSuffixText"
                    app:suffixTextColor="#667085"
                    tools:ignore="HardcodedText">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_vitals_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789."
                        android:fontFamily="@font/poppins_medium"
                        android:inputType="numberDecimal"
                        android:maxLength="6"
                        android:imeOptions="actionDone"
                        android:selectAllOnFocus="true"
                        android:textColor="#101828"
                        android:textSize="@dimen/_10sdp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="1dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_vitals_weight"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Weight (kg)"
                    app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                    app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                    app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                    app:boxCornerRadiusTopStart="@dimen/_8sdp"
                    app:suffixText="kg"
                    app:suffixTextAppearance="@style/PrescriptionVitalsSuffixText"
                    app:suffixTextColor="#667085"
                    tools:ignore="HardcodedText">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_vitals_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789."
                        android:fontFamily="@font/poppins_medium"
                        android:inputType="numberDecimal"
                        android:maxLength="6"
                        android:imeOptions="actionDone"
                        android:selectAllOnFocus="true"
                        android:textColor="#101828"
                        android:textSize="@dimen/_10sdp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- BMI -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_vitals_bmi"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:hint="BMI — automatically calculated"
                app:boxBackgroundColor="#F9FAFB"
                app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
                app:boxCornerRadiusBottomStart="@dimen/_8sdp"
                app:boxCornerRadiusTopEnd="@dimen/_8sdp"
                app:boxCornerRadiusTopStart="@dimen/_8sdp"
                app:suffixText="kg/m²"
                app:suffixTextAppearance="@style/PrescriptionVitalsSuffixText"
                app:suffixTextColor="#667085"
                tools:ignore="HardcodedText">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_vitals_bmi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/poppins_medium"
                    android:inputType="none"
                    android:textColor="#344054"
                    android:textSize="@dimen/_10sdp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Only visible while editing saved vitals -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_vitals"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_36sdp"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="CLEAR VITALS"
                android:textColor="#D92D20"
                android:textSize="@dimen/_7sdp"
                android:visibility="gone"
                app:iconTint="#D92D20"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAECF0" />
    <!-- Actions -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:background="@color/white"
        android:paddingBottom="@dimen/_10sdp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_vitals"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="CANCEL"
            android:textColor="@color/prescription_primary"
            android:textSize="@dimen/_9sdp"
            app:cornerRadius="@dimen/_8sdp"
            app:strokeColor="@color/green_sea"
            app:strokeWidth="1dp"
            tools:ignore="HardcodedText" />

        <Space
            android:layout_width="@dimen/_10sdp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_vitals"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="SAVE VITALS"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_9sdp"
            app:backgroundTint="@color/green_sea"
            app:cornerRadius="@dimen/_8sdp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</LinearLayout>