<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_prescription_history_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_6sdp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/_8sdp"
    app:cardElevation="0dp"
    app:strokeColor="@color/prescription_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_76sdp"
        android:padding="@dimen/_6sdp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_history_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_2sdp"
                android:layout_toStartOf="@+id/tv_history_code"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/prescription_text_primary"
                android:textSize="@dimen/_9sdp"
                tools:text="21-SEP-26" />

            <TextView
                android:id="@+id/tv_history_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@color/prescription_primary_light"
                android:fontFamily="@font/poppins_medium"
                android:paddingStart="@dimen/_5sdp"
                android:paddingTop="@dimen/_2sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:textColor="@color/prescription_primary"
                android:textSize="@dimen/_7sdp"
                tools:text="2600104" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/iv_prescription_history_item_selected"
                android:layout_marginEnd="@dimen/_2sdp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_history_department"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_medium"
                    android:maxLines="1"
                    android:textColor="@color/prescription_text_primary"
                    android:textSize="@dimen/_8sdp"
                    tools:text="Occupational Therapy" />

                <TextView
                    android:id="@+id/tv_history_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:maxLines="2"
                    android:textColor="@color/prescription_text_secondary"
                    android:textSize="@dimen/_7sdp"
                    tools:text="Speech &amp; Language Therapy Service Charge" />

                <TextView
                    android:id="@+id/tv_history_appointment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/prescription_text_secondary"
                    android:maxLines="2"
                    android:textSize="@dimen/_7sdp"
                    tools:text="Appointment: 20-SEP-26 • 03:30 PM" />

                <TextView
                    android:id="@+id/tv_history_prescription_creation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:textColor="@color/prescription_text_secondary"
                    android:maxLines="2"
                    android:textSize="@dimen/_7sdp"
                    tools:text="Created by: Munirul Islam SLT • Head of Speech &amp; Language Therpay Department" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_prescription_history_item_selected"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="@dimen/_4sdp"
                android:visibility="invisible"
                app:srcCompat="@drawable/outline_check_circle_24"
                app:tint="@color/green_sea"
                tools:visibility="visible" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_history_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/tv_presc_last_updated"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/prescription_primary"
                android:textSize="@dimen/_7sdp"
                tools:text="Indoor • Walk-in" />

            <TextView
                android:id="@+id/tv_presc_last_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/prescription_text_secondary"
                android:textSize="@dimen/_7sdp"
                tools:text="Last Updated: 20-SEP-26, 03:30 PM" />

        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>