<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_prescription_patient_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_5sdp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/_8sdp"
    app:cardElevation="0dp"
    app:strokeColor="@color/prescription_outline"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_64sdp"
        android:padding="@dimen/_9sdp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_patient_item_avatar"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@color/prescription_primary_light"
            app:cardCornerRadius="@dimen/_50sdp"
            app:cardElevation="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/_7sdp"
                app:srcCompat="@drawable/person_24"
                app:tint="@color/prescription_primary"
                tools:ignore="ContentDescription" />

        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_patient_item_selected"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="@dimen/_4sdp"
            android:visibility="invisible"
            app:srcCompat="@drawable/outline_check_circle_24"
            app:tint="@color/green_sea"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_toEndOf="@id/card_patient_item_avatar"
            android:layout_toStartOf="@id/ll_pat_area_year"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_patient_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:textColor="@color/prescription_text_primary"
                android:textSize="@dimen/_9sdp"
                tools:text="Ahasan Ul Haque Shuvo" />

            <TextView
                android:id="@+id/tv_patient_item_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/prescription_primary"
                android:textSize="@dimen/_7sdp"
                tools:text="23.01.000003.01" />

            <TextView
                android:id="@+id/tv_patient_item_gender_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="1"
                android:textColor="@color/prescription_text_secondary"
                android:textSize="@dimen/_7sdp"
                tools:text="Male • 32 Years 7 Months" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_pat_area_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/iv_patient_item_selected"
            android:layout_marginEnd="@dimen/_4sdp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_patient_thana_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_7sdp"
                android:layout_gravity="end"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/prescription_text_secondary"
                android:fontFamily="@font/poppins"
                tools:text="(Mirpur)" />

            <TextView
                android:id="@+id/tv_patient_reg_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_7sdp"
                android:ellipsize="end"
                android:layout_gravity="end"
                android:maxLines="1"
                android:textColor="@color/prescription_text_secondary"
                android:fontFamily="@font/poppins"
                tools:text="(2023)" />

            <TextView
                android:id="@+id/tv_patient_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_7sdp"
                android:ellipsize="end"
                android:layout_gravity="end"
                android:maxLines="1"
                android:textColor="@color/prescription_text_secondary"
                android:fontFamily="@font/poppins"
                tools:text="01952873612" />

        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>