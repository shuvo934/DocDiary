<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/_44sdp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_43sdp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/_11sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingEnd="@dimen/_11sdp"
        android:paddingBottom="@dimen/_6sdp">

        <!-- Main option name -->

        <TextView
            android:id="@+id/tv_clinical_option_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="2"
            android:textColor="@color/prescription_text_primary"
            android:textSize="@dimen/_9sdp"
            tools:text="Paresthesia in both upper limbs" />

        <!-- Optional doctor/source information -->

        <TextView
            android:id="@+id/tv_clinical_option_doctor_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:textColor="@color/prescription_text_secondary"
            android:textSize="@dimen/_7sdp"
            android:visibility="gone"
            tools:text="Added by current doctor"
            tools:visibility="visible" />

    </LinearLayout>

    <View
        android:id="@+id/view_clinical_option_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/_11sdp"
        android:layout_marginEnd="@dimen/_11sdp"
        android:background="@color/prescription_outline" />

</LinearLayout>