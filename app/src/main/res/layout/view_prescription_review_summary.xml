<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_8sdp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="@dimen/_10sdp"
    app:cardElevation="@dimen/_1sdp"
    app:strokeColor="#E4E7EC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_8sdp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_review_section_icon"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                app:cardBackgroundColor="#EAF7F8"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_review_section_icon"
                    android:layout_width="@dimen/_19sdp"
                    android:layout_height="@dimen/_19sdp"
                    android:layout_gravity="center"
                    app:tint="@color/green_sea"
                    android:contentDescription="Review section icon" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_review_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_9sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="Section"
                android:textColor="#101828"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/card_review_section_icon"
                app:layout_constraintStart_toEndOf="@id/card_review_section_icon"
                app:layout_constraintTop_toTopOf="@id/card_review_section_icon" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_review_section_badge"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_23sdp"
                android:layout_marginStart="@dimen/_7sdp"
                app:cardBackgroundColor="#E8F7F8"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@id/card_review_section_icon"
                app:layout_constraintStart_toEndOf="@id/tv_review_section_title"
                app:layout_constraintTop_toTopOf="@id/card_review_section_icon">

                <TextView
                    android:id="@+id/tv_review_section_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:minWidth="@dimen/_23sdp"
                    android:paddingStart="@dimen/_7sdp"
                    android:paddingEnd="@dimen/_7sdp"
                    android:text="0 items"
                    android:textColor="#159AA5"
                    android:textSize="9sp" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_review_section_edit"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/_18sdp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="center"
                    android:contentDescription="Edit section"
                    android:src="@drawable/edit_24" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEF1F4" />

        <TextView
            android:id="@+id/tv_review_section_empty"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="No information added"
            android:textColor="#98A2B3"
            android:textSize="11sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_review_section_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>