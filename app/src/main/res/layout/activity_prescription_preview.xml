<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/presc_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/green_gray_background"
    tools:context=".dynamic_prescription.preview.PrescriptionPreview">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:background="@color/white"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/prescription_preview_full_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:background="@color/light_green">

        <!-- Preview app bar -->
        <RelativeLayout
            android:id="@+id/app_bar_prescription_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/_48sdp"
            android:background="@color/light_green"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back_logo_of_prescription_preview"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_4sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="@dimen/_10sdp"
                app:srcCompat="@drawable/arrow_back"
                app:tint="@color/white"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_toEndOf="@id/back_logo_of_prescription_preview"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/app_bar_title_prescription_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="1"
                    android:text="Prescription Preview"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14sdp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tv_prescription_preview_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:maxLines="1"
                    android:text="Preparing prescription..."
                    android:textColor="#DFF4ED"
                    android:textSize="@dimen/_8sdp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Preview content -->

        <FrameLayout
            android:id="@+id/layout_prescription_preview_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#EEF2F5"
            app:layout_constraintBottom_toTopOf="@id/card_prescription_preview_actions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_bar_prescription_preview">

            <!--
                Final prescription HTML এই WebView-তে render হবে।
                WebView নিজেই vertically scroll করবে।
            -->

            <WebView
                android:id="@+id/webview_prescription_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/_4sdp"
                android:background="#EEF2F5"
                android:overScrollMode="never"
                android:scrollbarStyle="outsideOverlay"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Loading state -->

            <LinearLayout
                android:id="@+id/layout_prescription_preview_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/_12sdp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_prescription_preview"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:elevation="@dimen/_20sdp"
                    android:visibility="visible"
                    android:indeterminate="true"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/tv_prescription_preview_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Preparing prescription preview..."
                    android:textColor="@color/prescription_text_secondary"
                    android:textSize="@dimen/_8sdp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Error state -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_prescription_preview_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_12sdp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="@dimen/_2sdp"
                app:strokeColor="#F4B4AE"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Preview could not be loaded"
                        android:textColor="#B42318"
                        android:textSize="@dimen/_10sdp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tv_prescription_preview_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/poppins"
                        android:gravity="center"
                        android:text="Please check your connection and try again."
                        android:textColor="@color/prescription_text_secondary"
                        android:textSize="@dimen/_8sdp"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_retry_prescription_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="RETRY"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_8sdp"
                        app:backgroundTint="@color/green_sea"
                        app:cornerRadius="@dimen/_8sdp"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Fixed preview actions -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_prescription_preview_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="0dp"
            app:cardElevation="@dimen/_2sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_8sdp"
                android:paddingTop="@dimen/_6sdp"
                android:paddingEnd="@dimen/_8sdp"
                android:paddingBottom="@dimen/_6sdp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_download_prescription"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:alpha="0.45"
                    android:enabled="false"
                    android:fontFamily="@font/poppins_bold"
                    android:text="DOWNLOAD"
                    android:textColor="@color/prescription_primary"
                    android:textSize="@dimen/_8sdp"
                    app:cornerRadius="@dimen/_8sdp"
                    app:strokeColor="@color/green_sea"
                    app:strokeWidth="1dp"
                    tools:ignore="HardcodedText" />

                <Space
                    android:layout_width="@dimen/_5sdp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_print_prescription"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:alpha="0.45"
                    android:enabled="false"
                    android:fontFamily="@font/poppins_bold"
                    android:text="PRINT"
                    android:textColor="@color/prescription_primary"
                    android:textSize="@dimen/_8sdp"
                    app:cornerRadius="@dimen/_8sdp"
                    app:strokeColor="@color/green_sea"
                    app:strokeWidth="1dp"
                    tools:ignore="HardcodedText" />

                <Space
                    android:layout_width="@dimen/_5sdp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share_prescription"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:alpha="0.45"
                    android:enabled="false"
                    android:fontFamily="@font/poppins_bold"
                    android:text="SHARE"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_8sdp"
                    app:backgroundTint="@color/green_sea"
                    app:cornerRadius="@dimen/_8sdp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>